# Infrastruktur & rahasia saja. Parameter bisnis diatur di menu Admin (tersimpan di PostgreSQL).
DB_PASSWORD=ganti-ini
ITOC_JWT_SECRET=ganti-dengan-string-acak-panjang
ITOC_JWT_MINUTES=720
# Kunci enkripsi rahasia di database (SMTP, token konektor, URL webhook). Kosong = memakai ITOC_JWT_SECRET.
ITOC_SECRET_KEY=
ITOC_CORS_ORIGINS=
ITOC_RUN_SCHEDULER=true
# Kredensial konektor (nama variabel bisa diubah di Admin → Sumber data → config)
ME_AUTHTOKEN=
PRTG_USER=
PRTG_PASSHASH=
