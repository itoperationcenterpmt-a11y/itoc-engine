"formulas": [
 {"key": "tkIn", "label": "Tickets received", "source": "1_Dashboard_Service_Desk · Perhitungan", "text": "Tickets received = number of tickets with Created Time inside the period (and shift/location if selected). Sheet Perhitungan, 1_Dashboard_Service_Desk."},
 {"key": "tkDone", "label": "Completion rate", "source": "1_Dashboard_Service_Desk · Perhitungan", "text": "Completion rate = (tickets received − open tickets) ÷ tickets received. Open = status outside the list of done statuses (Admin → Operations → Targets & Parameters)."},
 {"key": "tkSla", "label": "% within SLA target", "source": "1_Dashboard_Service_Desk · Parameter A13:B17", "text": "% within SLA target = tickets within target ÷ (within target + exceeded). Duration = Resolved − Created − Onhold. Target per SLA Name (Admin → Operations → Targets & Parameters). Tickets without an SLA are not rated."},
 {"key": "tkMed", "label": "Median durasi", "source": "1_Dashboard_Service_Desk · Perhitungan", "text": "Median resolution time (minutes) of finished tickets with a valid duration."},
 {"key": "av", "label": "Availability", "source": "2_Dashboard_Network_SLA · Perhitungan", "text": "Availability = Σ Up ÷ Σ (Up + Down) of all sensors in the filter, in seconds. Sheet Perhitungan, 2_Dashboard_Network_SLA."},
 {"key": "link", "label": "Link SLA status", "source": "2_Dashboard_Network_SLA · Parameter B9:B10", "text": "A link meets the SLA when availability ≥ the ISP target (Admin → Data Sources → Mapping → ISP, default link availability target). Insufficient data when monitoring coverage is below the minimum data coverage."},
 {"key": "down", "label": "Total downtime", "source": "2_Dashboard_Network_SLA · Perhitungan", "text": "Total downtime = Σ seconds Down of all sensors ÷ 3600."},
 {"key": "util", "label": "Utilisasi", "source": "2_Dashboard_Network_SLA · Parameter B11:B12", "text": "Peak utilization = Max total traffic ÷ link capacity. Flagged when it exceeds the peak or average threshold (Admin → Operations → Targets & Parameters)."},
 {"key": "socTot", "label": "Total event SOC", "source": "3_Dashboard_SOC · Perhitungan", "text": "Total events = Σ Count of the SOC-Threat-Summary report on days that pass validation. Sheet Perhitungan, 3_Dashboard_SOC."},
 {"key": "socCH", "label": "Critical + High diblokir", "source": "3_Dashboard_SOC · Perhitungan", "text": "Critical + High blocked = critical/high events with an action other than alert/allow ÷ all critical/high events."},
 {"key": "socInt", "label": "Event internal", "source": "3_Dashboard_SOC · Parameter B9", "text": "Internal-source events = events whose source is in the internal range (Admin → Operations → Targets & Parameters) ÷ total events."}
],
