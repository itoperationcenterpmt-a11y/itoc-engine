"formulas": [
 {"key": "tkIn", "label": "Tiket masuk", "source": "1_Dashboard_Service_Desk · Perhitungan", "text": "Tiket masuk = jumlah tiket dengan Created Time di dalam periode (dan shift/lokasi bila dipilih). Sheet Perhitungan, 1_Dashboard_Service_Desk."},
 {"key": "tkDone", "label": "Tingkat penyelesaian", "source": "1_Dashboard_Service_Desk · Perhitungan", "text": "Tingkat penyelesaian = (tiket masuk − tiket terbuka) ÷ tiket masuk. Terbuka = status di luar daftar status selesai (Admin → Parameter)."},
 {"key": "tkSla", "label": "% dalam target SLA", "source": "1_Dashboard_Service_Desk · Parameter A13:B17", "text": "% dalam target SLA = tiket dalam target ÷ (dalam target + melewati). Durasi = Resolved − Created − Onhold. Target per SLA Name (Admin → Target SLA). Tiket tanpa SLA tidak dinilai."},
 {"key": "tkMed", "label": "Median durasi", "source": "1_Dashboard_Service_Desk · Perhitungan", "text": "Median durasi penyelesaian (menit) dari tiket yang sudah selesai dengan durasi valid."},
 {"key": "av", "label": "Availability", "source": "2_Dashboard_Network_SLA · Perhitungan", "text": "Availability = Σ Up ÷ Σ (Up + Down) semua sensor dalam filter, dalam detik. Sheet Perhitungan, 2_Dashboard_Network_SLA."},
 {"key": "link", "label": "Status SLA link", "source": "2_Dashboard_Network_SLA · Parameter B9:B10", "text": "Link capai SLA bila availability ≥ target ISP (Admin → ISP, default target availability link). Data kurang bila cakupan pantau di bawah cakupan data minimal."},
 {"key": "down", "label": "Total downtime", "source": "2_Dashboard_Network_SLA · Perhitungan", "text": "Total downtime = Σ detik Down semua sensor ÷ 3600."},
 {"key": "util", "label": "Utilisasi", "source": "2_Dashboard_Network_SLA · Parameter B11:B12", "text": "Utilisasi puncak = Max total trafik ÷ kapasitas link. Ditandai bila melewati ambang puncak atau ambang rata-rata (Admin → Parameter)."},
 {"key": "socTot", "label": "Total event SOC", "source": "3_Dashboard_SOC · Perhitungan", "text": "Total event = Σ Count laporan SOC-Threat-Summary pada hari yang lolos validasi. Sheet Perhitungan, 3_Dashboard_SOC."},
 {"key": "socCH", "label": "Critical + High diblokir", "source": "3_Dashboard_SOC · Perhitungan", "text": "Critical + High diblokir = event critical/high dengan tindakan selain alert/allow ÷ seluruh event critical/high."},
 {"key": "socInt", "label": "Event internal", "source": "3_Dashboard_SOC · Parameter B9", "text": "Event bersumber internal = event dengan source di rentang internal (Admin → Parameter) ÷ total event."}
],
