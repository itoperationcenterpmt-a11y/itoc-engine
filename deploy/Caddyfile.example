# Caddy berjalan sebagai container sendiri (compose terpisah) dan menjadi satu-satunya pintu 80/443 di server.
# Caddy bergabung ke jaringan khusus tiap aplikasi, jadi aplikasi tidak perlu membuka port ke host sama sekali.
# TERA membuat jaringan "tera-edge" saat `docker compose up`; container Caddy memanggil alias "tera-api".

tera.pelindomultiterminal.co.id {
    # Pilih satu:
    # 1) Domain publik dan server terjangkau dari internet di port 80/443: hapus baris tls, Caddy meminta Let's Encrypt otomatis.
    # 2) Sertifikat dari CA perusahaan (folder ./certs di-mount ke /certs pada container Caddy):
    # tls /certs/tera.crt /certs/tera.key
    # 3) CA internal Caddy (uji; root-nya harus dipasang di tiap klien):
    # tls internal

    encode zstd gzip
    request_body {
        max_size 50MB
    }
    reverse_proxy tera-api:9000 {
        transport http {
            response_header_timeout 900s   # sinkron manual (Panorama) bisa memakan beberapa menit
        }
    }
}

# Aplikasi berikutnya: jaringan sendiri (mis. app2-edge) yang juga di-join Caddy, lalu blok baru:
# app2.pelindomultiterminal.co.id {
#     reverse_proxy app2-api:8100
# }
